#!/bin/bash
#PBS -q cpu
#PBS -l walltime=00:20:00
#PBS -j oe
#PBS -N u10722968_scaling

# 1. Define your own log file with the Job ID
# ${PBS_JOBID%%.*} strips the ".login01" suffix to keep it short
# LOG_FILE="/work/u10722968/scaling_results.${PBS_JOBID%%.*}.log"
LOG_FILE="/work/u10722968/scaling_results.log"

cd /work/u10722968/

# Source PBS definitions
source /etc/profile.d/pbs.sh

# 2. Point to the correct executable 
EXE="./PACS_PROJ/build/parallel/clust_test_conv_speed_Psolve"


# Default arguments (e.g., passing nothing if your main loop handles N)
if [ -z "$PROG_ARGS" ]; then
    PROG_ARGS="" 
fi

# Initialize the log file
echo "========================================" > $LOG_FILE
echo "Job running on $NCPUS cores" >> $LOG_FILE
echo "Nodes: $(cat $PBS_NODEFILE)" >> $LOG_FILE
echo "Executing: $EXE $PROG_ARGS" >> $LOG_FILE
echo "========================================" >> $LOG_FILE

# 3. Run with explicit redirection (&>>)
# Note the '\' at the end of lines to keep the command together
/work/u10722968/nix-portable nix develop --extra-experimental-features "nix-command flakes" ./PACS_PROJ \
    --command mpirun -np $NCPUS \
    --hostfile $PBS_NODEFILE \
    --bind-to core \
    --map-by core \
    $EXE $PROG_ARGS &>> $LOG_FILE

